{
    "name": "phprise/multi-agent",
    "description": "Multi-agent kanban board with authentication, based on The OTAKU Manifesto.",
    "type": "project",
    "require": {
        "php": "^8.4",
        "phprise/common": "^2.0",
        "guzzlehttp/psr7": "^2.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "vimeo/psalm": "^6.14"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Esdras Schonevald",
            "email": "esdras.schonevald@gmail.com"
        }
    ],
    "minimum-stability": "stable"
