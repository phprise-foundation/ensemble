<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="src" />
        <directory name="public" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <UnusedClass>
            <errorLevel type="suppress">
                <file name="src/Application/Tenancy/Install.php" />
                <file name="src/Application/Kanban/BackfillIssueWorkdirs.php" />
                <file name="src/Application/Runner/ExecuteSweep.php" />
                <file name="src/Infrastructure/Runner/OpenCodeExecutor.php" />
                <file name="src/Infrastructure/Runner/GitWorkdirVcs.php" />
                <file name="src/Infrastructure/Runner/VarWorkdirPaths.php" />
            </errorLevel>
        </UnusedClass>
    </issueHandlers>
</psalm>
