# PostgreSQL (dev: docker compose -f docker-compose.dev.yml up -d)
APP_ENV=dev
DATABASE_URL=pgsql://phprise:phprise@127.0.0.1:5432/phprise
TEST_DATABASE_URL=pgsql://phprise:phprise@127.0.0.1:5432/phprise_test

# Bootstrap admin (used only when the database has no users yet)
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=admin1234
BOOTSTRAP_WORKSPACE_NAME=Default
BOOTSTRAP_WORKSPACE_PREFIX=KAN

# Legacy board (will be removed in the backend cutover)
BOARD_PASSWORD=admin
BOARD_DB_FILE=var/board.sqlite
BOARD_CHAT_FILE=var/chat.json

DEEPSEEK_API_KEY=
AW_MODEL=deepseek/deepseek-v4-pro
AW_FALLBACK_MODEL=deepseek/deepseek-v4-flash
AW_WORKSPACE=./workspace

# Copilot with the real chat service (run: docker compose --profile chat up -d)
# CHAT_URL=http://chat:8080
# CHAT_TOKEN=change-me
