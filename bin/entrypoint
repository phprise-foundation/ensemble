#!/bin/bash
set -uo pipefail

cd /var/www/html

role=${ENSEMBLE_ROLE:-all}
if [ "$role" != web ] && [ "$role" != runner ] && [ "$role" != all ]; then
  echo "invalid ENSEMBLE_ROLE '$role': use web, runner or all" >&2
  exit 2
fi

if [ -z "${DATABASE_URL:-}" ]; then
  echo "DATABASE_URL is required (use an external PostgreSQL and APP_ENV=production)" >&2
  exit 1
fi

logs=/var/log/apache2
mkdir -p "$logs"
touch "$logs/error.log" "$logs/access.log"
chown -R www-data:www-data "$logs" 2>/dev/null || true

tail -n +1 -F "$logs/error.log" "$logs/access.log" >&2 &
tail_pid=$!
pids=("$tail_pid")

supervise_runner() {
  while true; do
    bin/runner-loop
    echo "runner-loop exited (code $?), restarting in 5s" >&2
    sleep 5
  done
}

runner_pid=""
web_pid=""

if [ "$role" != runner ]; then
  if ! php bin/install; then
    echo "bin/install failed; refusing to start the web server" >&2
    kill "$tail_pid" 2>/dev/null
    exit 1
  fi
fi

if [ "$role" != web ]; then
  supervise_runner &
  runner_pid=$!
  pids+=("$runner_pid")
fi

if [ "$role" != runner ]; then
  apache2-foreground &
  web_pid=$!
  pids+=("$web_pid")
fi

terminate() {
  for pid in "${pids[@]:-}"; do
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
  done
}
trap terminate TERM INT

if [ "$role" = runner ]; then
  wait "$runner_pid"
else
  wait "$web_pid"
fi
status=$?
terminate
exit "$status"
