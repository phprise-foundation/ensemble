#!/bin/bash
set -euo pipefail

cd /var/www/html

role=${ENSEMBLE_ROLE:-all}
if [ "$role" != web ] && [ "$role" != runner ] && [ "$role" != all ]; then
  echo "invalid ENSEMBLE_ROLE '$role': use web, runner or all" >&2
  exit 2
fi

if [ -z "${DATABASE_URL:-}" ]; then
  echo "DATABASE_URL is required (use an external PostgreSQL and APP_ENV=production)" >&2
  exit 1
fi

pids=()

if [ "$role" != runner ]; then
  php bin/install
  apache2-foreground &
  pids+=("$!")
fi

if [ "$role" != web ]; then
  bin/runner-loop &
  pids+=("$!")
fi

terminate() {
  for pid in "${pids[@]:-}"; do
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
  done
}
trap terminate TERM INT

wait -n
status=$?
terminate
exit "$status"
