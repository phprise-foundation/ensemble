#!/usr/bin/env php
<?php

declare(strict_types=1);

$args = array_slice($argv, 1);
$command = $args[0] ?? '';
$sub = $args[1] ?? '';
$reason = '';
$body = '';
foreach ($args as $index => $argument) {
    if ($argument === '--reason') {
        $reason = $args[$index + 1] ?? '';
    }
    if ($argument === '--body') {
        $body = $args[$index + 1] ?? '';
    }
}

if ($command === 'profile') {
    $profilePath = getenv('ENS_PROFILE_FILE');
    if ($profilePath === false || $profilePath === '' || ! is_file($profilePath)) {
        fwrite(STDERR, "ENS_PROFILE_FILE is not configured\n");
        exit(1);
    }
    $raw = file_get_contents($profilePath);
    $data = is_string($raw) ? json_decode($raw, true) : null;
    if (! is_array($data)) {
        fwrite(STDERR, "the profile file is not valid JSON\n");
        exit(1);
    }
    $section = trim($sub);
    if ($section === '' || $section === 'all') {
        echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n";
        exit(0);
    }
    $value = $data['advanced'][$section] ?? $data[$section] ?? null;
    if ($value === null) {
        fwrite(STDERR, "unknown profile section: $section (use physical, communication, personality, interests, background or all)\n");
        exit(1);
    }
    echo json_encode($value, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n";
    exit(0);
}

if ($command === 'description') {
    $body = trim($body === '' ? $sub : $body);
    if ($body === '') {
        fwrite(STDERR, "usage: ens description --body \"...\"\n");
        exit(1);
    }
    if (mb_strlen($body) > 4095) {
        fwrite(STDERR, "the description must have at most 4095 characters\n");
        exit(1);
    }
    $descriptionPath = getenv('ENS_DESCRIPTION_FILE');
    if ($descriptionPath === false || $descriptionPath === '') {
        fwrite(STDERR, "ENS_DESCRIPTION_FILE is not configured\n");
        exit(1);
    }
    file_put_contents($descriptionPath, (string) json_encode(['body' => $body]));
    echo "Description queued.\n";
    exit(0);
}

if ($command === 'comment') {
    $body = trim($body === '' ? $sub : $body);
    if ($body === '') {
        fwrite(STDERR, "usage: ens comment --body \"...\"\n");
        exit(1);
    }
    if (mb_strlen($body) > 1023) {
        fwrite(STDERR, "comments must have at most 1023 characters\n");
        exit(1);
    }
    $commentPath = getenv('ENS_COMMENT_FILE');
    if ($commentPath === false || $commentPath === '') {
        fwrite(STDERR, "ENS_COMMENT_FILE is not configured\n");
        exit(1);
    }
    file_put_contents($commentPath, (string) json_encode(['body' => $body]) . "\n", FILE_APPEND);
    echo "Comment queued.\n";
    exit(0);
}

$outcome = match ($command . ' ' . $sub) {
    'test pass' => 'test_passed',
    'test fail' => 'test_failed',
    'review approve' => 'review_approved',
    'review request-changes' => 'changes_requested',
    'block ' => 'blocked',
    default => null,
};
if ($outcome === null) {
    fwrite(STDERR, "usage: ens profile [physical|communication|personality|interests|background|all], ens comment --body \"...\", ens description --body \"...\", ens test pass|fail, ens review approve|request-changes, ens block --reason \"...\"\n");
    exit(1);
}

$allowed = explode(',', (string) (getenv('ENS_ALLOWED_OUTCOMES') ?: 'blocked'));
if (! in_array($outcome, $allowed, true)) {
    fwrite(STDERR, 'this stage does not allow the outcome ' . $outcome . "\n");
    exit(1);
}

if (in_array($outcome, ['test_failed', 'changes_requested', 'blocked'], true) && trim($reason) === '') {
    fwrite(STDERR, "this outcome requires --reason \"...\"\n");
    exit(1);
}

$path = getenv('ENS_OUTCOME_FILE');
if ($path === false || $path === '') {
    fwrite(STDERR, "ENS_OUTCOME_FILE is not configured\n");
    exit(1);
}

file_put_contents($path, (string) json_encode([
    'outcome' => $outcome,
    'reason' => mb_substr(trim($reason), 0, 500),
]));

echo 'Outcome registered: ' . $outcome . "\n";
